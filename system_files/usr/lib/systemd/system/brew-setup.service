[Unit]
Description=Set up Homebrew in /home/linuxbrew (one-time)
Wants=network-online.target
After=network-online.target
ConditionPathExists=!/var/lib/silverblue-plus/brew-setup.done
StartLimitIntervalSec=0

[Service]
Type=oneshot
ExecStart=/usr/libexec/brew-setup
Restart=on-failure
RestartSec=60

[Install]
WantedBy=multi-user.target
