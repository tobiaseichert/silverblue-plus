#!/usr/bin/env bash
# One-time migration: make Flathub the only Flatpak source.
#  1. add/enable Flathub
#  2. move every app that came from Fedora's remote to Flathub
#     (app data in ~/.var/app is kept)
#  3. remove the Fedora runtime and the Fedora remotes
#  4. install a few default apps from Flathub (only once; uninstalling
#     them later is respected)
# Flathub not reachable -> exit non-zero, systemd retries every minute;
# these runs don't count. Single apps that fail don't stop the rest; runs
# with failures are retried up to MAX_RUNS times, then the failures are
# logged and the migration ends.
# Fedora's remote is only removed once nothing installed depends on it.
set -euo pipefail

STATE=/var/lib/silverblue-plus
STAMP="${STATE}/flathub-migrate.done"
RUNS="${STATE}/flathub-migrate.runs"
# Apps already uninstalled from Fedora's remote but not yet installed from
# Flathub (e.g. the download failed). Retried on every run until installed.
PENDING="${STATE}/flathub-migrate.pending"
MAX_RUNS=5

# Default Flathub apps installed on first boot
DEFAULT_APPS=(
    io.github.kolunmi.Bazaar          # Flatpak app store (alongside GNOME Software)
    io.missioncenter.MissionCenter    # System monitor incl. GPU
    org.gnome.World.PikaBackup        # Backups (Borg) to external drive/NAS
    org.chromium.Chromium             # WebHID tools (e.g. Fractal Adjust), Chromium testing
    org.gnome.Boxes                   # Virtual machines (bundles its own QEMU)
    io.github.Faugus.faugus-launcher  # Windows games via Proton (UMU), prefixes, Steam shortcuts
    io.github.flattool.Warehouse      # Manage Flatpaks, data and leftovers
)
[[ -e "${STAMP}" ]] && exit 0

FP=(flatpak --system --noninteractive --assumeyes)

# Real request to Flathub. Needed because flatpak's own errors look the
# same offline and for refs that don't exist ("No such ref").
online() {
    curl -fsS -o /dev/null --head --max-time 20 https://dl.flathub.org/repo/summary.idx
}
retry_later() {
    echo "Flathub is not reachable (offline?); retrying later"
    exit 1
}

pending_add() { mkdir -p "${STATE}"; echo "$1" >> "${PENDING}"; }
pending_del() {
    [[ -e "${PENDING}" ]] || return 0
    grep -vxF "$1" "${PENDING}" > "${PENDING}.tmp" || true
    mv "${PENDING}.tmp" "${PENDING}"
}

online || retry_later

flatpak remote-add --system --if-not-exists flathub \
    https://dl.flathub.org/repo/flathub.flatpakrepo
flatpak remote-modify --system --enable flathub
flatpak update --system --appstream flathub || retry_later

fedora_refs() {
    flatpak list --system --columns=application,origin "$@" \
        | awk -F'\t' '$2 ~ /^fedora/ {print $1}'
}

failed=()
keep_fedora=0

# Leftovers from an earlier run: already gone from Fedora, install them now
if [[ -s "${PENDING}" ]]; then
    mapfile -t pending_apps < "${PENDING}"
    for app in "${pending_apps[@]}"; do
        [[ -z "${app}" ]] && continue
        echo "Installing ${app} from Flathub (left over from an earlier run)"
        if "${FP[@]}" install --or-update flathub "${app}"; then
            pending_del "${app}"
        else
            failed+=("${app}")
        fi
    done
fi

mapfile -t fedora_apps < <(fedora_refs --app)
for app in "${fedora_apps[@]}"; do
    [[ -z "${app}" ]] && continue
    if ! info="$(flatpak remote-info --system flathub "app/${app}/x86_64/stable" 2>/dev/null)"; then
        online || retry_later
        echo "${app} is not on Flathub, keeping the Fedora build"
        keep_fedora=1
        continue
    fi
    echo "Moving ${app} from Fedora's remote to Flathub"

    # Download the runtime first (the big part). If that fails, the Fedora
    # build is still untouched. The app itself can't be downloaded ahead:
    # flatpak refuses while it's installed from another remote.
    runtime="$(awk '/^ *Runtime:/ {print $2}' <<< "${info}")"
    if [[ -n "${runtime}" ]] && \
       ! "${FP[@]}" install --or-update flathub "runtime/${runtime}"; then
        echo "Downloading ${runtime} failed, keeping the Fedora build of ${app} for now"
        failed+=("${app}")
        keep_fedora=1
        continue
    fi

    # Uninstall + install, not --reinstall: flatpak refuses to switch when
    # Flathub's build is older than Fedora's ("Update is older than current
    # version"). Uninstalling without --delete-data keeps ~/.var/app.
    if ! "${FP[@]}" uninstall "${app}"; then
        failed+=("${app}")
        keep_fedora=1
        continue
    fi
    # Restoring from Fedora's remote isn't possible here (it needs a desktop
    # session), so a failed install is remembered and retried instead.
    pending_add "${app}"
    if "${FP[@]}" install flathub "${app}"; then
        pending_del "${app}"
    else
        echo "Installing ${app} from Flathub failed, will retry"
        failed+=("${app}")
    fi
done

"${FP[@]}" uninstall --unused || true

if [[ "${keep_fedora}" -eq 0 && -z "$(fedora_refs)" ]]; then
    for remote in fedora fedora-testing; do
        if flatpak remotes --system --columns=name | grep -qx "${remote}"; then
            flatpak remote-delete --system "${remote}"
        fi
    done
else
    echo "Some refs still come from Fedora's remote; leaving it in place."
fi

# One by one, so a single failure doesn't block the others.
# --or-update: no error if an app is already installed (e.g. migrated above)
for app in "${DEFAULT_APPS[@]}"; do
    "${FP[@]}" install --or-update flathub "${app}" || failed+=("${app}")
done

mkdir -p "${STATE}"
if (( ${#failed[@]} )); then
    # Failures caused by the network going away don't count
    online || retry_later
    runs=$(( $(cat "${RUNS}" 2>/dev/null || echo 0) + 1 ))
    echo "${runs}" > "${RUNS}"
    echo "Failed (run ${runs}/${MAX_RUNS}): ${failed[*]}"
    if (( runs < MAX_RUNS )); then
        exit 1
    fi
    echo "Giving up on: ${failed[*]} (install them manually, e.g. in GNOME Software)"
fi

rm -f "${RUNS}" "${PENDING}"
touch "${STAMP}"
