#!/usr/bin/env bash
# One-time Homebrew setup in /home/linuxbrew/.linuxbrew (the standard Linux
# prefix, so bottles work). Unpacks the snapshot shipped in the image (no
# network needed) and hands the prefix to the first user (UID 1000, which
# GNOME's first-boot setup creates). An existing install is left untouched.
set -euo pipefail

PREFIX=/home/linuxbrew/.linuxbrew
ARCHIVE=/usr/share/homebrew.tar.zst
STAMP=/var/lib/silverblue-plus/brew-setup.done
OWNER=1000:1000
[[ -e "${STAMP}" ]] && exit 0

if [[ ! -e "${PREFIX}" ]]; then
    TMP=/home/linuxbrew/.setup.tmp
    rm -rf "${TMP}"
    mkdir -p "${TMP}"
    tar --zstd -xf "${ARCHIVE}" -C "${TMP}"
    mv "${TMP}/.linuxbrew" "${PREFIX}"
    rmdir "${TMP}"
fi

chown -R "${OWNER}" /home/linuxbrew

mkdir -p "$(dirname "${STAMP}")"
touch "${STAMP}"
