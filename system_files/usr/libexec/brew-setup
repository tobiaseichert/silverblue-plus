#!/usr/bin/env bash
# One-time Homebrew setup in /home/linuxbrew/.linuxbrew (the standard Linux
# prefix, so bottles work). Runs as root at boot, hands the prefix to the
# first user (UID 1000, which GNOME's first-boot setup creates).
# Fails without network -> systemd retries.
set -euo pipefail

PREFIX=/home/linuxbrew/.linuxbrew
STAMP=/var/lib/silverblue-plus/brew-setup.done
OWNER=1000:1000
[[ -e "${STAMP}" ]] && exit 0

if [[ ! -x "${PREFIX}/bin/brew" ]]; then
    rm -rf "${PREFIX}.tmp"
    mkdir -p "${PREFIX}.tmp"
    git clone https://github.com/Homebrew/brew "${PREFIX}.tmp/Homebrew"
    mkdir -p "${PREFIX}.tmp/bin"
    ln -s ../Homebrew/bin/brew "${PREFIX}.tmp/bin/brew"
    mv "${PREFIX}.tmp" "${PREFIX}"
fi

chown -R "${OWNER}" /home/linuxbrew

mkdir -p "$(dirname "${STAMP}")"
touch "${STAMP}"
